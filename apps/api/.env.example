# Comma-separated origins allowed by CORS (frontend dev server, etc.)
CORS_ALLOW_ORIGINS=http://localhost:3000

# Where pipeline artifacts are written. Resolved relative to apps/api if not absolute.
DATA_DIR=../../data

# ---------------------------------------------------------------------------
# LLM provider configuration.
# Adapter pattern -- product code never references a provider directly.
# Set LLM_PROVIDER and the matching variables below.
# Never commit real keys -- this file is documentation; .env is gitignored.
# ---------------------------------------------------------------------------

# One of: seed | mock
LLM_PROVIDER=seed

# ByteDance Seed (AIGC) -- primary provider for this project.
# Required when LLM_PROVIDER=seed:
SEED_API_KEY=
SEED_MODEL=
# Optional legacy/custom endpoint; otherwise the public SEED_MODEL ID is used.
SEED_ENDPOINT_ID=
# For recent Seed models, disable thinking for bounded JSON planning.
# Leave empty for older models that do not support the thinking parameter.
# SEED_THINKING=disabled

# Optional: override the default Seed base URL.
# Defaults to https://ark.cn-beijing.volces.com/api/v3 (Volcano Ark cn-beijing).
# Only set this if your deployment uses a different region or host.
SEED_API_BASE_URL=

# Trial app (production: use one worker, a persistent DATA_DIR and HTTPS)
APP_ENV=development
LEGACY_LOCAL_API=false
COOKIE_SECURE=false
SESSION_DAYS=7
INVITE_QUOTA=3
GLOBAL_GENERATION_LIMIT=10
MAX_UPLOAD_MB=30
MAX_VIDEO_SECONDS=30

# Optional semantic retrieval (PostgreSQL + pgvector)
DATABASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=doubao-embedding-vision-251215
EMBEDDING_DIMENSIONS=1024
EMBEDDING_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Optional visual generation. Separate from Seed text planning.
SEEDANCE_ENABLED=false
SEEDANCE_PROVIDER=seedance
SEEDANCE_API_KEY=
SEEDANCE_MODEL=
SEEDANCE_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_GLOBAL_LIMIT=2
SEEDANCE_TIMEOUT_SECONDS=600
